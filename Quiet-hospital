    ctx.ellipse(20+i*5,30+i*10,8,12,0.2,0,Math.PI*2);
    ctx.fill();
  }
  
  ctx.restore();
}

// ============ МИНИ-КАРТА ============
function renderMinimap(){
  if(!showMinimap)return;
  const scale = 140/Math.max(MAP_W,MAP_H);
  miniCtx.fillStyle='rgba(0,0,0,0.8)';
  miniCtx.fillRect(0,0,140,140);
  for(let y=0;y<MAP_H;y++){
    for(let x=0;x<MAP_W;x++){
      if(MAP[y][x]>0){
        if(MAP[y][x]===2){
          const door = getDoorAt(x,y);
          miniCtx.fillStyle = door && door.openAmount>0.9 ? '#060' : '#555';
        }else{
          miniCtx.fillStyle = MAP[y][x]===5?'#333':'#555';
        }
        miniCtx.fillRect(x*scale,y*scale,scale,scale);
      }
    }
  }
  for(const item of items){
    if(item.collected)continue;
    miniCtx.fillStyle='#ff0';
    miniCtx.fillRect(item.x*scale-1,item.y*scale-1,3,3);
  }
  miniCtx.fillStyle=player.itemsCollected>=10?'#0f0':'#600';
  miniCtx.fillRect(exit.x*scale-2,exit.y*scale-2,4,4);
  const mdx=monster.x-player.x,mdy=monster.y-player.y;
  const mdist=Math.sqrt(mdx*mdx+mdy*mdy);
  if(mdist<8){
    miniCtx.fillStyle='#f00';
    miniCtx.beginPath();
    miniCtx.arc(monster.x*scale,monster.y*scale,3,0,Math.PI*2);
    miniCtx.fill();
  }
  miniCtx.fillStyle='#0ff';
  miniCtx.beginPath();
  miniCtx.arc(player.x*scale,player.y*scale,2,0,Math.PI*2);
  miniCtx.fill();
  miniCtx.strokeStyle='#0ff';
  miniCtx.beginPath();
  miniCtx.moveTo(player.x*scale,player.y*scale);
  miniCtx.lineTo(player.x*scale+Math.cos(player.angle)*8,player.y*scale+Math.sin(player.angle)*8);
  miniCtx.stroke();
}

// ============ ОБНОВЛЕНИЕ ============
function update(dt){
  if(gameState!=='playing')return;
  
  for(const door of doors){
    if(door.openAmount < door.targetOpen){
      door.openAmount = Math.min(door.targetOpen, door.openAmount + dt*2);
    }else if(door.openAmount > door.targetOpen){
      door.openAmount = Math.max(door.targetOpen, door.openAmount - dt*2);
    }
  }
  
  let moveX=0,moveY=0;
  const moveSpeed = 0.06;
  let moving = false;
  if(keys['KeyW']){moveX+=Math.cos(player.angle)*moveSpeed;moveY+=Math.sin(player.angle)*moveSpeed;moving=true}
  if(keys['KeyS']){moveX-=Math.cos(player.angle)*moveSpeed;moveY-=Math.sin(player.angle)*moveSpeed;moving=true}
  if(keys['KeyA']){moveX+=Math.cos(player.angle-Math.PI/2)*moveSpeed;moveY+=Math.sin(player.angle-Math.PI/2)*moveSpeed;moving=true}
  if(keys['KeyD']){moveX+=Math.cos(player.angle+Math.PI/2)*moveSpeed;moveY+=Math.sin(player.angle+Math.PI/2)*moveSpeed;moving=true}
  
  const margin=0.25;
  if(isWalkable(player.x+moveX+Math.sign(moveX)*margin, player.y))player.x+=moveX;
  if(isWalkable(player.x, player.y+moveY+Math.sign(moveY)*margin))player.y+=moveY;
  
  if(moving){
    player.stepTimer+=dt;
    if(player.stepTimer>0.45){playSound('step');player.stepTimer=0}
  }
  
  if(player.flashlightOn){
    player.battery-=dt*2;
    if(player.battery<=0){player.battery=0;player.flashlightOn=false}
    updateHUD();
  }
  
  if(player.invulnTimer>0)player.invulnTimer-=dt;
  
  updateMonster(dt);
  
  let hintText = '';
  const checkDist = 1.5;
  const checkX = player.x + Math.cos(player.angle)*checkDist;
  const checkY = player.y + Math.sin(player.angle)*checkDist;
  const tileX = Math.floor(checkX);
  const tileY = Math.floor(checkY);
  
  if(tileX>=0&&tileX<MAP_W&&tileY>=0&&tileY<MAP_H&&MAP[tileY][tileX]===2){
    const door = getDoorAt(tileX,tileY);
    if(door){
      hintText = door.open ? 'E - закрыть дверь' : 'E - открыть дверь';
    }
  }else{
    for(const item of items){
      if(item.collected)continue;
      const dx=player.x-item.x,dy=player.y-item.y;
      if(Math.sqrt(dx*dx+dy*dy)<1.2){
        hintText = 'E - подобрать';
        break;
      }
    }
  }
  
  const hintEl = document.getElementById('pickupHint');
  hintEl.textContent = hintText;
  hintEl.classList.toggle('show', hintText !== '');
  
  const dx=player.x-exit.x,dy=player.y-exit.y;
  if(Math.sqrt(dx*dx+dy*dy)<0.8 && player.itemsCollected>=10)winGame();
  
  ambientTimer+=dt;
  if(ambientTimer>8+Math.random()*5){playSound('ambient',0.3);ambientTimer=0}
}

function updateMonster(dt){
  if(monster.state==='stunned'){
    monster.stunTimer-=dt;
    if(monster.stunTimer<=0)monster.state='patrol';
    return;
  }
  const dx=player.x-monster.x,dy=player.y-monster.y;
  const dist=Math.sqrt(dx*dx+dy*dy);
  let canSee=false;
  if(dist<14){
    const angleToPlayer=Math.atan2(dy,dx);
    const ray=castRay(angleToPlayer);
    if(ray.dist>=dist-0.5)canSee=true;
  }
  if(canSee){
    monster.state='chase';
    monster.lastKnownPlayerX=player.x;
    monster.lastKnownPlayerY=player.y;
  }
  let targetX,targetY;
  if(monster.state==='chase'){
    targetX=monster.lastKnownPlayerX;
    targetY=monster.lastKnownPlayerY;
    const tdx=targetX-monster.x,tdy=targetY-monster.y;
    if(Math.sqrt(tdx*tdx+tdy*tdy)<0.5 && !canSee){
      monster.state='patrol';
    }
  }else{
    monster.patrolTimer-=dt;
    if(monster.patrolTimer<=0 || !monster.patrolTarget || 
       Math.sqrt((monster.x-monster.patrolTarget.x)**2+(monster.y-monster.patrolTarget.y)**2)<0.5){
      monster.patrolTarget={x:1.5+Math.random()*(MAP_W-3),y:1.5+Math.random()*(MAP_H-3)};
      monster.patrolTimer=5+Math.random()*5;
    }
    targetX=monster.patrolTarget.x;
    targetY=monster.patrolTarget.y;
  }
  const tdx=targetX-monster.x,tdy=targetY-monster.y;
  const tdist=Math.sqrt(tdx*tdx+tdy*tdy);
  if(tdist>0.1){
    const speed = monster.state==='chase'?0.038:0.02;
    const mx=(tdx/tdist)*speed,my=(tdy/tdist)*speed;
    const margin=0.3;
    if(isWalkable(monster.x+mx+Math.sign(mx)*margin, monster.y))monster.x+=mx;
    if(isWalkable(monster.x, monster.y+my+Math.sign(my)*margin))monster.y+=my;
  }
  if(dist<0.8 && player.invulnTimer<=0)hurtPlayer();
  monster.soundTimer+=dt;
  if(monster.soundTimer>3 && dist<12 && monster.state==='chase'){
    playSound('monster',0.4);monster.soundTimer=0;
  }
}

function hurtPlayer(){
  player.lives--;
  player.invulnTimer=2;
  playSound('hurt',0.5);
  document.getElementById('damageEffect').classList.add('active');
  setTimeout(()=>document.getElementById('damageEffect').classList.remove('active'),1000);
  const dx=monster.x-player.x,dy=monster.y-player.y;
  const dist=Math.sqrt(dx*dx+dy*dy)||1;
  monster.x+=(dx/dist)*3;monster.y+=(dy/dist)*3;
  if(player.lives<=0)gameOver();
  updateHUD();
}

function useFlash(){
  if(flashCooldown>0||player.battery<15)return;
  player.battery-=15;
  flashCooldown=1.5;
  document.getElementById('flashEffect').classList.add('active');
  setTimeout(()=>document.getElementById('flashEffect').classList.remove('active'),500);
  playSound('flash',0.5);
  const dx=monster.x-player.x,dy=monster.y-player.y;
  const dist=Math.sqrt(dx*dx+dy*dy);
  if(dist<12){
    const angle=Math.atan2(dy,dx)-player.angle;
    let a=angle;while(a<-Math.PI)a+=2*Math.PI;while(a>Math.PI)a-=2*Math.PI;
    if(Math.abs(a)<FOV/2){
      monster.state='stunned';monster.stunTimer=4;
    }
  }
  updateHUD();
}

function updateHUD(){
  document.getElementById('lives').textContent=player.lives;
  document.getElementById('items').textContent=player.itemsCollected;
  document.getElementById('score').textContent=player.score;
  document.getElementById('battery').textContent=Math.floor(player.battery);
  document.getElementById('flashlightStatus').textContent=player.flashlightOn?'ВКЛ':'ВЫКЛ';
  const bf=document.getElementById('batteryFill');
  bf.style.width=player.battery+'%';
  bf.classList.toggle('low',player.battery<30);
}

// ============ ИГРОВОЙ ЦИКЛ ============
function gameLoop(time){
  const dt=Math.min((time-lastTime)/1000,0.1);
  lastTime=time;
  if(gameState==='playing'){
    update(dt);
    render();
    renderMinimap();
    document.getElementById('noiseFill').style.height=(noiseLevel*100)+'%';
    if(flashCooldown>0)flashCooldown-=dt;
  }
  requestAnimationFrame(gameLoop);
}

// ============ УПРАВЛЕНИЕ СОСТОЯНИЕМ ============
function startGame(){
  initAudio();
  initMic();
  document.getElementById('menu').classList.add('hidden');
  document.getElementById('hud').classList.remove('hidden');
  player.x=2.5;player.y=2.5;player.angle=0;
  player.lives=3;player.score=0;player.battery=100;
  player.flashlightOn=false;player.itemsCollected=0;player.invulnTimer=0;
  player.phoneState='down';player.phoneAnim=0;
  monster.x=28.5;monster.y=12.5;monster.state='patrol';monster.stunTimer=0;
  initDoors();
  spawnItems();
  spawnFurniture();
  initParticles();
  gameState='playing';
  updateHUD();
  canvas.requestPointerLock();
}

function gameOver(){
  gameState='gameover';
  document.getElementById('hud').classList.add('hidden');
  document.getElementById('gameover').classList.remove('hidden');
  document.getElementById('finalScore').textContent=player.score;
  document.getElementById('finalItems').textContent=player.itemsCollected;
  document.exitPointerLock();
}

function winGame(){
  gameState='win';
  player.score+=100+player.lives*25;
  document.getElementById('hud').classList.add('hidden');
  document.getElementById('win').classList.remove('hidden');
  document.getElementById('winScore').textContent=player.score;
  document.getElementById('winLives').textContent=player.lives;
  document.exitPointerLock();
}

function restartGame(){
  document.getElementById('gameover').classList.add('hidden');
  document.getElementById('win').classList.add('hidden');
  startGame();
}

requestAnimationFrame(gameLoop);
</script>
